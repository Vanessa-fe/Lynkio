# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enrichissement de contact (bouton "Trouver un contact" sur les agences)
# Clé personnelle depuis https://hunter.io/api_keys — ne jamais préfixer par NEXT_PUBLIC_
HUNTER_API_KEY=your_hunter_io_api_key

# Offres d'emploi France Travail (signal « recrute un développeur » de Sophie)
# Application déclarée sur https://francetravail.io — côté serveur uniquement, jamais NEXT_PUBLIC_
# À enregistrer aussi dans les secrets Supabase (fonction prospection-run) : voir docs/refonte-prospection.md
FRANCE_TRAVAIL_CLIENT_ID=your_france_travail_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_france_travail_client_secret
